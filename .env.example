# Copy to .env.local for local dev. Set the same keys in Vercel, then redeploy.
# Never commit real keys. Google's OAuth client secret does not go here;
# it is saved only in the Supabase Google provider settings.
#
# Project: VibeBin Project (free tier, Nano compute)
# If the dashboard Project URL differs, use that value instead.

NEXT_PUBLIC_SUPABASE_URL=https://jxcvnnsrvjvimttmohn.supabase.co
# Publishable key (sb_publishable_...) or the legacy anon key. Safe in the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret key (sb_secret_...) or the legacy service_role key. Server only.
# Used by /api/paddle/webhook. Bypasses row level security.
SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
NEXT_PUBLIC_PADDLE_PRICE_MONTHLY=
NEXT_PUBLIC_PADDLE_PRICE_YEARLY=
PADDLE_WEBHOOK_SECRET=
